# Copy to .env.local and fill in. Names only here; never commit real values.

# Tavus API key, server only, sent only to tavusapi.com in the x-api-key header.
TAVUS_API_KEY=
# Shared secret for the HMAC on the synthesize_profile tool call (openssl rand -hex 32).
TOOL_HMAC_SECRET=
# Public https production URL that Tavus calls for synthesize_profile, no trailing slash.
PUBLIC_BASE_URL=
# Passcode a visitor types before a call can be created.
DEMO_PASSCODE=
# Call arc in minutes: 5 (300 s cap, the default, fits the Free plan) or 7 (600 s cap).
FORGE_ARC=
# true keeps calls private with a meeting token; false drops require_auth.
FORGE_REQUIRE_AUTH=
# always adds policy eu to every call; never leaves it off.
FORGE_EU_POLICY=
# true adds test_mode: the call is created as ended and the PAL never joins (a free payload check).
FORGE_TEST_MODE=
# Folder of the read-only source corpus that scripts/build-corpus.ts reads.
CORPUS_DIR=

# Upstash for Redis: set one pair. The Vercel Marketplace names:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or the Upstash console names:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
